# Placeholders only. Copy to .env and fill locally; never share it.
NODE_ENV=development
PUBLIC_URL=http://localhost:3000
PORT=3000
DATABASE_URL=postgresql://bridge:REPLACE_DATABASE_PASSWORD@localhost:5432/bridge
POSTGRES_PASSWORD=REPLACE_DATABASE_PASSWORD
OIDC_ISSUER=https://auth.example.com/realms/buffer-bridge
OIDC_CLIENT_ID=bridge-admin
OIDC_CLIENT_SECRET=REPLACE_ADMIN_CLIENT_SECRET
INTROSPECTION_CLIENT_ID=bridge-resource
INTROSPECTION_CLIENT_SECRET=REPLACE_RESOURCE_CLIENT_SECRET
OWNER_SUBJECTS=REPLACE_EXACT_OWNER_OIDC_SUBJECT
ENCRYPTION_KEYS_FILE=./secrets/encryption-keys.json
ENCRYPTION_ACTIVE_VERSION=v1
BUFFER_CONTRACT_FILE=./config/buffer-contract.json
# Production compose uses a DNS name without scheme.
BRIDGE_DOMAIN=bridge.example.com
# Probe only: never put an actual Buffer key here.
# BUFFER_API_KEY_FILE=C:/private/buffer.key
# BUFFER_SHAPE_FILE=./secrets/shape.json
