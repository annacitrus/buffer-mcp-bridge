# Only non-secret runtime metadata. Secrets are mounted by Compose.
NODE_ENV=production
PUBLIC_URL=https://bridge.example.com
BRIDGE_DOMAIN=bridge.example.com
PORT=3000
OIDC_ISSUER=https://auth.example.com/realms/buffer-bridge
OIDC_CLIENT_ID=bridge-admin
INTROSPECTION_CLIENT_ID=bridge-resource
OWNER_SUBJECTS=REPLACE_EXACT_OWNER_OIDC_SUBJECT
ENCRYPTION_ACTIVE_VERSION=v1
BUFFER_CONTRACT_FILE=/app/config/buffer-contract.json
